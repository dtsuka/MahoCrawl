{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MahoCrawl",
  "version": "0.2.2",
  "identifier": "jp.tsukada.mahocrawl",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MahoCrawl",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/siteone-crawler"],
    "resources": [
      "../Resources/Binaries/VERSION",
      "../Resources/Binaries/checksums.sha256",
      "../Resources/Licenses/SiteOne-Crawler-LICENSE.txt",
      "../Resources/Licenses/THIRD_PARTY_NOTICES.txt",
      "../Resources/Binaries/BUILD_METADATA.json"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
