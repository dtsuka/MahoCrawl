{
  "name": "maho-crawl",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:siteone": "bash scripts/build-siteone-custom.sh",
    "build:app": "bash scripts/generate-third-party-licenses.sh && bash scripts/with-remapped-paths.sh tauri build --bundles app && bash scripts/copy-macos-app.sh",
    "build:release": "bash scripts/generate-third-party-licenses.sh && bash scripts/build-release-zips.sh",
    "licenses": "bash scripts/generate-third-party-licenses.sh",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.7.0",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.7.1",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  }
}
