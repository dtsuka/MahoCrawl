+
+
+fn should_provide_scoped_auth(
+    scoped: &ScopedCredentials,
+    locked_realm: &Option<String>,
+    event: &EventAuthRequired,
+) -> bool {
+    if event.auth_challenge.source != Some(AuthChallengeSource::Server) {
+        return false;
+    }
+    if !event.auth_challenge.scheme.eq_ignore_ascii_case("basic") {
+        return false;
+    }
+    if !scoped.matches_url(&event.request.url) {
+        return false;
+    }
+    if !scoped.matches_origin_string(&event.auth_challenge.origin) {
+        return false;
+    }
+    scoped.matches_realm(locked_realm, &event.auth_challenge.realm)
+}
