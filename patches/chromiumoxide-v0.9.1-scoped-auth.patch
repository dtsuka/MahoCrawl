 }
+
+/// Basic auth credentials limited to a single canonical origin.
+#[derive(Debug, Clone)]
+pub struct ScopedCredentials {
+    pub origin_scheme: String,
+    pub origin_host: String,
+    pub origin_port: u16,
+    pub username: String,
+    pub password: String,
+}
+
+impl ScopedCredentials {
+    pub fn new(
+        origin_scheme: impl Into<String>,
+        origin_host: impl Into<String>,
+        origin_port: u16,
+        username: impl Into<String>,
+        password: impl Into<String>,
+    ) -> Self {
+        Self {
+            origin_scheme: origin_scheme.into().to_ascii_lowercase(),
+            origin_host: origin_host.into().to_ascii_lowercase(),
+            origin_port,
+            username: username.into(),
+            password: password.into(),
+        }
+    }
+
+    pub fn from_url(
+        url: &str,
+        username: impl Into<String>,
+        password: impl Into<String>,
+    ) -> Option<Self> {
+        let parsed = match url::Url::parse(url) {
+            Ok(value) => value,
+            Err(_) => return None,
+        };
+        let scheme = parsed.scheme().to_ascii_lowercase();
+        if scheme != "http" && scheme != "https" {
+            return None;
+        }
+        let host = match parsed.host_str() {
+            Some(value) => value.to_ascii_lowercase(),
+            None => return None,
+        };
+        let port = parsed.port_or_known_default().unwrap_or(80);
+        Some(Self::new(scheme, host, port, username, password))
+    }
+
+    pub fn matches_url(&self, url: &str) -> bool {
+        match url::Url::parse(url) {
+            Ok(parsed) => self.matches_parsed(&parsed),
+            Err(_) => false,
+        }
+    }
+
+    pub fn matches_origin_string(&self, origin: &str) -> bool {
+        match url::Url::parse(origin) {
+            Ok(parsed) => self.matches_parsed(&parsed),
+            Err(_) => false,
+        }
+    }
+
+    fn matches_parsed(&self, parsed: &url::Url) -> bool {
+        let scheme = parsed.scheme().to_ascii_lowercase();
+        if scheme != self.origin_scheme {
+            return false;
+        }
+        let host = match parsed.host_str() {
+            Some(value) => value.to_ascii_lowercase(),
+            None => return false,
+        };
+        if host != self.origin_host {
+            return false;
+        }
+        let port = parsed.port_or_known_default().unwrap_or(80);
+        port == self.origin_port
+    }
+
+    pub fn matches_realm(&self, locked_realm: &Option<String>, challenge_realm: &str) -> bool {
+        match locked_realm {
+            Some(expected) => expected == challenge_realm,
+            None => true,
+        }
+    }
+}
+
+
+#[cfg(test)]
+mod scoped_tests {
+    use super::ScopedCredentials;
+
+    fn scoped() -> ScopedCredentials {
+        ScopedCredentials::from_url("http://127.0.0.1:8765/", "user", "pass").expect("scoped")
+    }
+
+    #[test]
+    fn matches_same_origin_and_default_port() {
+        let scoped = ScopedCredentials::from_url("https://example.com/path", "u", "p").unwrap();
+        assert!(scoped.matches_url("https://example.com/other"));
+        assert!(scoped.matches_origin_string("https://example.com"));
+        assert!(!scoped.matches_url("http://example.com/other"));
+        assert!(!scoped.matches_url("https://sub.example.com/other"));
+        assert!(!scoped.matches_url("https://example.com:8443/other"));
+    }
+
+    #[test]
+    fn realm_is_locked_after_first_challenge() {
+        let scoped = scoped();
+        assert!(scoped.matches_realm(&None, "test"));
+        assert!(scoped.matches_realm(&Some("test".into()), "test"));
+        assert!(!scoped.matches_realm(&Some("test".into()), "other"));
+    }
+}
