diff --git a/src/http_auth.rs b/src/http_auth.rs
new file mode 100644
index 0000000..792cd2f
--- /dev/null
+++ b/src/http_auth.rs
@@ -0,0 +1,75 @@
+use url::Url;
+
+pub fn parse_basic_auth(value: &str) -> Option<(String, String)> {
+    let trimmed = value.trim();
+    if trimmed.is_empty() {
+        return None;
+    }
+    let (user, password) = trimmed.split_once(':')?;
+    if user.is_empty() {
+        return None;
+    }
+    Some((user.to_string(), password.to_string()))
+}
+
+pub fn read_http_auth_from_stdin() -> Result<String, String> {
+    use std::io::{self, Read};
+    let mut buffer = String::new();
+    io::stdin()
+        .read_to_string(&mut buffer)
+        .map_err(|error| format!("failed to read HTTP auth from stdin: {}", error))?;
+    let trimmed = buffer.trim();
+    if trimmed.is_empty() {
+        return Err("stdin HTTP auth is empty".to_string());
+    }
+    if parse_basic_auth(trimmed).is_none() {
+        return Err("stdin HTTP auth must be in username:password format".to_string());
+    }
+    Ok(trimmed.to_string())
+}
+
+pub fn scoped_credentials_for_url(
+    url: &str,
+    auth: &str,
+) -> Option<chromiumoxide::ScopedCredentials> {
+    let (username, password) = parse_basic_auth(auth)?;
+    chromiumoxide::ScopedCredentials::from_url(url, username, password)
+}
+
+pub fn canonical_origin(url: &str) -> Option<(String, String, u16)> {
+    let parsed = match Url::parse(url) {
+        Ok(value) => value,
+        Err(_) => return None,
+    };
+    let scheme = parsed.scheme().to_ascii_lowercase();
+    if scheme != "http" && scheme != "https" {
+        return None;
+    }
+    let host = parsed.host_str()?.to_string();
+    let port = parsed.port_or_known_default().unwrap_or(80);
+    Some((scheme, host, port))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parse_basic_auth_accepts_user_password() {
+        let (user, password) = parse_basic_auth("user:pass").expect("auth");
+        assert_eq!(user, "user");
+        assert_eq!(password, "pass");
+    }
+
+    #[test]
+    fn canonical_origin_normalizes_default_ports() {
+        assert_eq!(
+            canonical_origin("https://example.com/path"),
+            Some(("https".to_string(), "example.com".to_string(), 443))
+        );
+        assert_eq!(
+            canonical_origin("http://127.0.0.1:8765/"),
+            Some(("http".to_string(), "127.0.0.1".to_string(), 8765))
+        );
+    }
+}
